    <node id="n11" x="200.0" y="200.0" type="traffic_light"/>
    <node id="n12" x="400.0" y="200.0" type="traffic_light"/>
    
    <!-- Row 2 -->
    <node id="n20" x="0.0" y="400.0" type="traffic_light"/>
