    <node id="west0" x="-100.0" y="0.0" type="priority"/>
    <node id="west1" x="-100.0" y="200.0" type="priority"/>
    <node id="west2" x="-100.0" y="400.0" type="priority"/>
    
    <!-- East exits -->
    <node id="east0" x="500.0" y="0.0" type="priority"/>
    <node id="east1" x="500.0" y="200.0" type="priority"/>
    <node id="east2" x="500.0" y="400.0" type="priority"/>
</nodes>
